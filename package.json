{
  "name": "font-fallback",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generator of metric-adjusted fallback font stacks with live preview and CLS estimation",
  "license": "MIT",
  "repository": "github:fogrew/font-fallback",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "lefthook install || exit 0",
    "lint:arch": "feod-analyzer analyze . --fail-on warning",
    "verify": "pnpm lint && pnpm lint:arch && pnpm check && pnpm build"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.6",
    "@preact/signals": "2.11.3",
    "astro": "7.3.7",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@feod/analyzer": "0.1.1",
    "lefthook": "2.2.1",
    "typescript": "6.0.3"
  }
}
